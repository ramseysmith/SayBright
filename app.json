{
  "expo": {
    "name": "SayBright",
    "slug": "saybright",
    "owner": "ramsta30",
    "version": "1.3.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9330c2a-1001-462b-a165-aca2816dd8e5"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "saybright",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF9A6B"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/android/notification.png",
          "color": "#F5A623"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-8327362355420246~5390186376"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This allows SayBright to show you more relevant content and support the free version of the app."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "SayBright records your voice reading affirmations so you can play them back."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saybright.app",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.saybright.app"
        ]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SayBright uses the microphone only when you tap the record button, so you can save an affirmation in your own voice and hear it back during your daily practice. For example, you can record yourself saying “I am calm and capable” and set it to play with that affirmation each morning. Recordings are stored on your device and are never uploaded.",
        "NSUserTrackingUsageDescription": "This allows SayBright to show you more relevant content and support the free version of the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/adaptive-foreground.png",
        "backgroundColor": "#FF9A6B",
        "monochromeImage": "./assets/android/adaptive-monochrome.png"
      },
      "package": "com.graysmithlabs.saybright",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9330c2a-1001-462b-a165-aca2816dd8e5"
      }
    }
  }
}
